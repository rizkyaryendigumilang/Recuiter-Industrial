# ==============================================================================
# Recruiter Industrial — Frontend Environment Variables Template
# Copy this file to .env.local for local development.
# ==============================================================================

# 1. PocketBase Backend URLs
# Local development default: http://127.0.0.1:8090
NEXT_PUBLIC_PB_URL=http://127.0.0.1:8090
PB_INTERNAL_URL=http://127.0.0.1:8090

# 2. Deployment Base Path (optional)
# Leave empty for root domain hosting (e.g., https://my-app.com)
# Set to '/recruiter' only if deployed behind a reverse proxy under a subpath
NEXT_PUBLIC_BASE_PATH=

# 3. Helpdesk & Notification Integration
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890

# 4. Security Keys & Webhook Signing Secrets
CALENDAR_FEED_SECRET=dev_calendar_secret_local
NEXT_PUBLIC_CALENDAR_TOKEN=dev_calendar_secret_local
WEBHOOK_SIGNING_SECRET=dev_webhook_secret_local
TELEGRAM_BOT_TOKEN=

# 5. Object Storage Decoupling (Cloudflare R2 / AWS S3 - Optional)
# If omitted, uploads fall back automatically to local disk under public/uploads/
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=recruiter-industrial
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto
